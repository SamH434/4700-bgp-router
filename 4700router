#!/usr/bin/env -S python3 -u

import argparse, socket, time, json, select, struct, sys, math

class Router:

    relations = {}
    sockets = {}
    ports = {}

    def __init__(self, asn, connections):
        print("Router at AS %s starting up" % asn)
        self.asn = asn
        self.routes = []
        # forwarding table built from self.routes (aggregated)
        self.table = []

        for relationship in connections:
            port, neighbor, relation = relationship.split("-")

            self.sockets[neighbor] = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            self.sockets[neighbor].bind(('localhost', 0))
            self.ports[neighbor] = int(port)
            self.relations[neighbor] = relation
            self.send(neighbor, json.dumps({ "type": "handshake", "src": self.our_addr(neighbor), "dst": neighbor, "msg": {}  }))

    # our address on the link to a neighbor
    def our_addr(self, dst):
        quads = list(int(qdn) for qdn in dst.split('.'))
        quads[3] = 1
        return "%d.%d.%d.%d" % (quads[0], quads[1], quads[2], quads[3])

    # send message to a neighbor
    def send(self, network, message):
        self.sockets[network].sendto(message.encode('utf-8'), ('localhost', self.ports[network]))

    # convert dotted quad string to 32 bit integer
    def ip_to_int(self, ip):
        parts = [int(x) for x in ip.split('.')]
        return (parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]

    # convert 32 bit integer back to dotted quad string
    def int_to_ip(self, num):
        return "%d.%d.%d.%d" % ((num >> 24) & 255, (num >> 16) & 255, (num >> 8) & 255, num & 255)

    # number of 1 bits in a netmask
    def mask_len(self, netmask):
        return bin(self.ip_to_int(netmask)).count('1')

    # build a netmask string from a prefix length
    def len_to_mask(self, length):
        return self.int_to_ip((0xFFFFFFFF << (32 - length)) & 0xFFFFFFFF)

    # decide who gets a copy of an update/withdraw that came from srcif
    def should_forward(self, srcif, neighbor):
        if neighbor == srcif:
            return False
        return self.relations[srcif] == "cust" or self.relations[neighbor] == "cust"

    # handle route update message
    def handle_update(self, srcif, msg):
        m = msg["msg"]
        self.routes.append({
            "network": m["network"],
            "netmask": m["netmask"],
            "localpref": m["localpref"],
            "selfOrigin": m["selfOrigin"],
            "ASPath": m["ASPath"],
            "origin": m["origin"],
            "peer": srcif
        })
        self.rebuild_table()
       
        for neighbor in self.sockets:
            if self.should_forward(srcif, neighbor):
                out = {
                    "type": "update",
                    "src": self.our_addr(neighbor),
                    "dst": neighbor,
                    "msg": {
                        "network": m["network"],
                        "netmask": m["netmask"],
                        "ASPath": [self.asn] + m["ASPath"]
                    }
                }
                self.send(neighbor, json.dumps(out))

    # handle route withdrawal
    def handle_withdraw(self, srcif, msg):
        for dead in msg["msg"]:
            self.routes = [r for r in self.routes
                           if not (r["peer"] == srcif and r["network"] == dead["network"] and r["netmask"] == dead["netmask"])]
        # rebuild from scratch so anything aggregated gets split back up
        self.rebuild_table()

        for neighbor in self.sockets:
            if self.should_forward(srcif, neighbor):
                out = {
                    "type": "withdraw",
                    "src": self.our_addr(neighbor),
                    "dst": neighbor,
                    "msg": msg["msg"]
                }
                self.send(neighbor, json.dumps(out))

    # rebuild forwarding table from all saved routes and aggregate it
    def rebuild_table(self):
        self.table = [dict(r) for r in self.routes]
        self.aggregate()

    # two routes can be merged if everything except the network matches
    def same_attributes(self, a, b):
        return (a["peer"] == b["peer"] and a["netmask"] == b["netmask"] and
                a["localpref"] == b["localpref"] and a["selfOrigin"] == b["selfOrigin"] and
                a["ASPath"] == b["ASPath"] and a["origin"] == b["origin"])

    # merge numerically adjacent routes into one shorter prefix
    def aggregate(self):
        merged = True
        while merged:
            merged = False
            for i in range(len(self.table)):
                for j in range(len(self.table)):
                    a = self.table[i]
                    b = self.table[j]
                    if i == j or not self.same_attributes(a, b):
                        continue
                    length = self.mask_len(a["netmask"])
                    if length == 0:
                        continue
                    shorter = self.ip_to_int(self.len_to_mask(length - 1))
                    a_net = self.ip_to_int(a["network"])
                    b_net = self.ip_to_int(b["network"])
                    if a_net != b_net and (a_net & shorter) == (b_net & shorter):
                        a["network"] = self.int_to_ip(a_net & shorter)
                        a["netmask"] = self.len_to_mask(length - 1)
                        del self.table[j]
                        merged = True
                        break
                if merged:
                    break

    # return true if route a is better than route b (used when prefixes are equal)
    def is_better(self, a, b):
        if a["localpref"] != b["localpref"]:
            return a["localpref"] > b["localpref"]
        if a["selfOrigin"] != b["selfOrigin"]:
            return a["selfOrigin"]
        if len(a["ASPath"]) != len(b["ASPath"]):
            return len(a["ASPath"]) < len(b["ASPath"])
        rank = {"IGP": 0, "EGP": 1, "UNK": 2}
        if rank[a["origin"]] != rank[b["origin"]]:
            return rank[a["origin"]] < rank[b["origin"]]
        return self.ip_to_int(a["peer"]) < self.ip_to_int(b["peer"])

    # find best route for a destination (longest prefix first, then tie breaking rules)
    def best_route(self, dst):
        dst_int = self.ip_to_int(dst)
        best = None
        for r in self.table:
            mask = self.ip_to_int(r["netmask"])
            if (dst_int & mask) != (self.ip_to_int(r["network"]) & mask):
                continue
            if best is None:
                best = r
            elif self.mask_len(r["netmask"]) > self.mask_len(best["netmask"]):
                best = r
            elif self.mask_len(r["netmask"]) == self.mask_len(best["netmask"]) and self.is_better(r, best):
                best = r
        return best

    # handle data message
    def handle_data(self, srcif, msg):
        route = self.best_route(msg["dst"])

        if route and (self.relations[srcif] == "cust" or self.relations[route["peer"]] == "cust"):
            self.send(route["peer"], json.dumps(msg))
        else:
            reply = { "type": "no route", "src": self.our_addr(srcif), "dst": msg["src"], "msg": {} }
            self.send(srcif, json.dumps(reply))

    # handle dump request
    def handle_dump(self, srcif, msg):
        reply = { "type": "table", "src": self.our_addr(srcif), "dst": msg["src"], "msg": self.table }
        self.send(srcif, json.dumps(reply))

    def run(self):
        while True:
            socks = select.select(self.sockets.values(), [], [], 0.1)[0]
            for conn in socks:
                k, addr = conn.recvfrom(65535)
                srcif = None
                for sock in self.sockets:
                    if self.sockets[sock] == conn:
                        srcif = sock
                        break
                msg = json.loads(k.decode('utf-8'))

                if msg["type"] == "update":
                    self.handle_update(srcif, msg)
                elif msg["type"] == "withdraw":
                    self.handle_withdraw(srcif, msg)
                elif msg["type"] == "data":
                    self.handle_data(srcif, msg)
                elif msg["type"] == "dump":
                    self.handle_dump(srcif, msg)
        return

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='route packets')
    parser.add_argument('asn', type=int, help="AS number of this router")
    parser.add_argument('connections', metavar='connections', type=str, nargs='+', help="connections")
    args = parser.parse_args()
    router = Router(args.asn, args.connections)
    router.run()